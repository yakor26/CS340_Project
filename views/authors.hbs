<h1>Authors</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each authors.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the author id, first name, last name, email }}
        {{#each authors}}
        <tr>
            <td>{{this.authorID}}</td>
            <td>{{this.firstName}}</td>
            <td>{{this.lastName}}</td>
            <td>{{this.email}}</td>

            {{! DELETE form }}
            <form id='delete_author_form' method="POST" action='/authors/delete'>
                <input type='hidden' name='delete_author_id' value='{{this.authorID}}' />
                <input type='hidden' name='delete_author_name' value='{{this.firstName}} {{this.lastName}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<h2>Create an Author</h2>
<form class='authorForm' id='create_author_form' method="POST" action='/authors/create'>
    <label for='create_author_fname'>First Name: </label>
    <input type='text' name='create_author_fname' id='create_author_fname' required />

    <label for='create_author_lname'>Last Name: </label>
    <input type='text' name='create_author_lname' id='create_author_lname' required />

    <label for='create_author_email'>Email: </label>
    <input type='text' name='create_author_email' id='create_author_email' required/>

    <input type='submit' />
</form>

{{! UPDATE form }}
<h2>Update an Author</h2>
<form class='authorForm' id='update_author_form'>
    <label for='update_author_id'>Author to Update: </label>
    <select name='update_author_id' id='update_author_id' required>
        <option value='' disabled selected>Select an Author</option>
        {{#each authors}}
        <option value='{{this.authorID}}' required>
            {{this.authorID}}
            -
            {{this.firstName}}
            {{this.lastName}}
        </option>
        {{/each}}
    </select>
    {{!-- work on prefilling existing info to edit --}}
    <label for='update_author_first_name'>First Name: </label>
    <input type='text' name='update_author_first_name' id='update_author_first_name' />

    <label for='update_author_last_name'>Last Name: </label>
    <input type='text' name='update_author_last_name' id='update_author_last_name' />

    <label for='update_author_email'>Email: </label>
    <input type='text' name='update_author_email' id='update_author_email' />
     
    <input type='submit' />
</form>