<script src="/js/authorsbooksprefill.js"></script>

<h1>Authors Books</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{!-- {{#each authorsbooks.[0]}} --}}
            <th>authorBookID</th>
            <th>authorID</th>
            <th>authorName</th>
            <th>bookID</th>
            <th>booktitle</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the author id, book id}}
        {{#each authorsbooks}}
        <tr>
            <td>{{this.authorBookID}}</td>
            <td>{{this.authorID}}</td>
            <td>{{firstName}} {{lastName}}</td>
            <td>{{this.bookID}}</td>
            <td>{{bookTitle}}</td>
            

            <td>
                {{! DELETE form }}
                <form id='delete_author_books_form'>
                <input type='hidden' name='delete_author_book_id' value='{{this.authorBookID}}' />
                    <button type='submit'>
                        Delete
                    </button>
                </form>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<h2>Create an Author Book Relationship</h2>
<form class='authorBookForm' id='create_author_book_form' method='POST' action='/authorsbooks/create'>
    <label for='create_author_id'> Author: </label>
    <select name='create_author_id' id='create_author_id' required>
     <option value='' disabled selected>Select Author</option>
        {{#each authors}}
        <option value='{{this.authorID}}' required>
            {{this.authorID}} - {{this.firstName}} {{this.lastName}}
         </option>
        {{/each}}
    </select>

    <label for='create_book_id'> Book: </label>
    <select name='create_book_id' id='create_book_id' required>
     <option value='' disabled selected>Select Book</option>
        {{#each books}}
        <option value='{{this.bookID}}' required>
            {{this.bookID}} - {{this.title}}
         </option>
        {{/each}}
    </select>

    
    <button type="submit">Submit</button>
</form>

{{! UPDATE form }}
{{! dropdowns to select id want to edit, prefill, then update}}
<h2>Update an Authors/Books</h2>
<form class='authorBookForm' id='update_author_book_form' method='POST' action='/authorsbooks/update'>
    <label for='update_author_book_id'>Select Author/Book to Update: </label>
    <select name='update_author_book_id' id='update_author_book_id' required>
        <option value='' disabled selected>Select Author/Book Relationship</option>
        {{#each authorsbooks}}
        {{!-- <option value='{{this.authorBookID}}' required>
            {{this.authorBookID}} - Author: {{this.firstName}} {{this.lastName}}, Book Title: {{this.bookTitle}}
        </option> --}}
        {{!-- // Citation for use of AI Tools for edit authorsbooks:
        // Date: 12/05/2025
        // Prompts to determine how to prefill current values in dropdowns
        // "how can I make it so that when user selects id values are preselected to show what the current value
        //  before updating value?"
        // included snippet of code
        // adapted code
        // AI Source URL: https://copilot.microsoft.com/ --}}
        <option 
            value="{{this.authorBookID}}"
            data-author="{{this.authorID}}"
            data-book="{{this.bookID}}">
            {{this.authorBookID}} — {{this.firstName}} {{this.lastName}} / {{this.bookTitle}}
        </option>
        {{/each}}
    </select>

    <label for='update_author_id'> Author to Update: </label>
    <select name='update_author_id' id='update_author_id' required>
     <option value='' disabled selected>Select Author</option>
        {{#each authors}}
        <option value='{{this.authorID}}' required>
            {{this.authorID}} - {{this.firstName}} {{this.lastName}}
         </option>
        {{/each}}
    </select>

    <label for='update_book_id'> Book to Update: </label>
    <select name='update_book_id' id='update_book_id' required>
     <option value='' disabled selected>Select Book</option>
        {{#each books}}
        <option value='{{this.bookID}}' required>
            {{this.bookID}} - {{this.title}}
         </option>
        {{/each}}
    </select>

<button type="submit">Update</button>
</form>




     