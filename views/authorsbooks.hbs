<h1>Authors Books</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{!-- {{#each authorsbooks.[0]}} --}}
            <th>authorBookID</th>
            <th>authorID</th>
            <th>authorName</th>
            <th>bookID</th>
            <th>booktitle</th>
            <th></th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the author id, book id}}
        {{#each authorsbooks}}
        <tr>
            <td>{{this.authorBookID}}</td>
            <td>{{this.authorID}}</td>
            <td>{{firstName}} {{lastName}}</td>
            <td>{{this.bookID}}</td>
            <td>{{bookTitle}}</td>
            

            {{! UPDATE form }}
            <form class='authorBookForm' id='update_author_book_form'>
                <td>
                    <button type="submit">Edit</button>
                </td>
            </form>

            {{! DELETE form }}
            <form id='delete_author_books_form'>
                <input type='hidden' name='delete_author_book_id' value='{{this.authorBookID}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>


