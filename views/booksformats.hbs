<h1>Book Formats</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            <th>bookFormatID</th>
            <th>bookID</th>
            <th>bookTitle</th>
            <th>formatID</th>
            <th>formatCategory</th>
            <th>price</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row }}
        {{#each booksformats}}
        <tr>
            <td>{{this.bookFormatID}}</td>
            <td>{{this.bookID}}</td>
            <td>{{this.bookTitle}}</td>
            <td>{{this.formatID}}</td>
            <td>{{this.formatCategory}}</td>
            <td>{{this.price}}</td>
            <td>
                 {{! DELETE form }}
                <form id='delete_books_formats_form'>
                    <input type='hidden' name='delete_books_formats_id' value='{{this.bookFormatID}}' />
                    <button type='submit'>
                        Delete
                    </button>
                </form>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! UPDATE form }}
<h2>Update Books Formats</h2>
<form class='bookFormatForm' id='update_book_format_form' method='POST' action='/booksformats/update'>
    <label for='update_book_format_id'>Book Format to Update: </label>
    <select name='update_book_format_id' id='update_book_format_id' required>
        <option value='' disabled selected>Select BookFormatID</option>
        {{#each booksformats}}
        <option value='{{this.bookFormatID}}' required>
            {{this.bookFormatID}} - Book Title: {{this.bookTitle}}, Format: {{this.formatCategory}}
        </option>
        {{/each}}
    </select>

    <label for='update_book_id'> Book to Update: </label>
    <select name='update_book_id' id='update_book_id' required>
     <option value='' disabled selected>Select Book</option>
        {{#each books}}
        <option value='{{this.bookID}}' required>
            {{this.bookID}} - {{this.title}}
         </option>
        {{/each}}
    </select>

     <label for='update_format_id'> Format to Update: </label>
    <select name='update_format_id' id='update_format_id' required>
     <option value='' disabled selected>Select Format</option>
        {{#each formats}}
        <option value='{{this.formatID}}' required>
            {{this.formatID}} - {{this.category}}
         </option>
        {{/each}}
    </select>

    <label for='update_price'> Price to Update: </label>
    <input type='number' name='update_price' step="0.01" required/>


    <button>Update</button>
</form>