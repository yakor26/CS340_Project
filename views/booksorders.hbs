<h1>Books/Orders</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            <th>bookOrderID</th>
            <th>orderID</th>
            <th>buyer</th>
            <th>bookID</th>
            <th>bookTitle</th>
            <th>quantity</th>
            <th>actions</th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the order id, book id, quantity}}
        {{#each booksorders}}
        <tr>
            <td>{{this.bookOrderID}}</td>
            <td>{{this.orderID}}</td>
            <td>{{this.buyer}}</td>
            <td>{{this.bookID}}</td>
            <td>{{bookTitle}}</td>
            <td>{{this.quantity}}</td>

            {{! UPDATE form }}
                <td class="actions">
                    <form class='bookOrderForm' id='update_book_order_form'></form>
                    <button type="submit">Edit</button>
                    </form>
                    
                    {{! DELETE form }}
                    <form id='delete_books_orders_form'>
                    <input type='hidden' name='delete_order_id' value='{{this.bookOrderID}}' />
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>


