<h1>Books/Orders</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            <th>bookOrderID</th>
            <th>orderID</th>
            <th>buyer</th>
            <th>bookID</th>
            <th>bookTitle</th>
            <th>quantity</th>
            {{!-- <th></th> --}}
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the order id, book id, quantity}}
        {{#each booksorders}}
        <tr>
            <td>{{this.bookOrderID}}</td>
            <td>{{this.orderID}}</td>
            <td>{{this.buyer}}</td>
            <td>{{this.bookID}}</td>
            <td>{{bookTitle}}</td>
            <td>{{this.quantity}}</td>

            {{!-- <td>
                {{! DELETE form }}
                <form id='delete_books_orders_form'>
                    <input type='hidden' name='delete_book_order_id' value='{{this.bookOrderID}}' />
                    <button type='submit'>
                        Delete
                    </button>
                </form>
            </td> --}}
        </tr>
        {{/each}}
    </tbody>
</table>


{{! UPDATE form }}
<h2>Update an Order/Book</h2>
<form class='bookOrderForm' id='update_order_book_form' method='POST' action='/booksorders/update'>
    <label for='update_book_order_id'>Books/Orders to Update: </label>
    <select name='update_book_order_id' id='update_book_order_id' required>
        <option value='' disabled selected>Select a BookOrder ID</option>
        {{#each booksorders}}
        <option value='{{this.bookOrderID}}' required>
            {{this.bookOrderID}} - Order ID: {{this.orderID}}  Book Title: {{this.bookTitle}}
        </option>
        {{/each}}
    </select>

    <label for='update_order_id'> Order to Update: </label>
    <select name='update_order_id' id='update_order_id' required>
     <option value='' disabled selected>Select Order</option>
        {{#each orders}}
        <option value='{{this.orderID}}' required>
            Order ID: {{this.orderID}} - Order Date: {{this.orderDate}}
         </option>
        {{/each}}
    </select>

    <label for='update_book_id'> Book to Update: </label>
    <select name='update_book_id' id='update_book_id' required>
     <option value='' disabled selected>Select Book</option>
        {{#each books}}
        <option value='{{this.bookID}}' required>
            {{this.bookID}} - {{this.title}}
         </option>
        {{/each}}
    </select>

    <label for='update_book_quantity'> Quantity to Update: </label>
    <input type='number' name='update_book_quantity' min="1" required/>

    <button>Submit</button>
</form>
