<h2>Create an Order</h2>
<form class='orderForm' id='create_order_form' method= "POST" action='/orders/create'>
    {{!reference all available buyers to select from}}
    <label for='create_order_buyer'>Buyer: </label>
    <select name='create_order_buyer' id='create_order_buyer' required>
        <option value='' disabled selected>Select a Buyer</option>
        {{#each buyers}}
        <option value='{{this.buyerID}}' required>
            {{this.buyerID}}
            -
            {{this.name}}
        </option>
        {{/each}}
    </select>

    <label for='create_order_date'>Order Date: </label>
    <input type='date' name='create_order_date' id='create_order_date'required/>
    <button type="submit">Submit</button>
</form>


